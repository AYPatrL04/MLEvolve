    "namespace": "ecepxie"
  },
  "spec": {
    "backoffLimit": 0,
    "activeDeadlineSeconds": 10800,
    "template": {
      "metadata": {
        "labels": {
          "app": "mlevolve-full-a10-s42-20260914",
