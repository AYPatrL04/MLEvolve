# Load from the repository root after selecting the actual graph profile.
# Example: export MLEVOLVE_HWKG_HARDWARE_ID=nvidia.ampere.a10.spec
: "${MLEVOLVE_HWKG_HARDWARE_ID:?Set the matching graph profile ID without hw:}"
export MLEVOLVE_HWKG_HARDWARE_ID
export MLEVOLVE_HWKG_GRAPH_PATH="${PWD}/hwkg/graph.json"
export MLEVOLVE_HWKG_GRAPH_SHA256=91e52fd2f7299b24c782f63f600ed4e2fa429a7159f9743d912b1dcf922efd3a
export MLEVOLVE_HWKG_EVIDENCE_POLICY=v8
export MLEVOLVE_HWKG_AUDIT_DIR="${MLEVOLVE_HWKG_AUDIT_DIR:-${PWD}/runs/hwkg-audit}"

# No bundled host-specific timing evidence. Explicit owned records are optional.
export MLEVOLVE_HWKG_CALIBRATION_PATH=""
export MLEVOLVE_HWKG_OPTIMIZER_CALIBRATION_PATH=""
